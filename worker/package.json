{
  "name": "sigaa-caiu-worker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:local": "wrangler d1 execute sigaa-caiu-unb-db --local --file=schema.sql",
    "db:remote": "wrangler d1 execute sigaa-caiu-unb-db --remote --file=schema.sql",
    "db:verify": "node scripts/db-verify.mjs",
    "db:verify:local": "node scripts/db-verify.mjs --local",
    "cache:stats": "node scripts/cache-stats.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241205.0",
    "typescript": "^5.7.0",
    "wrangler": "^3.99.0"
  }
}
